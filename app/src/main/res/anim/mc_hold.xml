<?xml version="1.0" encoding="utf-8"?>
<!-- Full: the screen underneath sinks back slightly. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_cubic" android:duration="300">
    <scale android:fromXScale="1" android:toXScale="0.96" android:fromYScale="1" android:toYScale="0.96"
        android:pivotX="50%" android:pivotY="50%" />
    <alpha android:fromAlpha="1" android:toAlpha="0.6" />
</set>
